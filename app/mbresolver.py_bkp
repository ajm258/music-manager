from difflib import SequenceMatcher


def similarity(a, b):
    return SequenceMatcher(
        None,
        (a or "").lower(),
        (b or "").lower(),
    ).ratio()


def score(track, candidate):

    score = 0

    # Title
    score += similarity(track.title, candidate.get("title")) * 40

    # Artist
    artist = ""

    if candidate.get("artist-credit"):
        artist = candidate["artist-credit"][0]["name"]

    # score += similarity(
    #     track.artist,
    #     artist
    # ) * 30

    # Album
    album = ""

    if candidate.get("release-list"):
        album = candidate["release-list"][0].get("title", "")

    # score += similarity(
    #    track.album,
    #    album
    # ) * 20

    print(f"{s:5.1f} | " f"{candidate['title']} | " f"{artist} | " f"{album}")
    # Duration

    if candidate.get("length"):

        seconds = int(candidate["length"]) / 1000

        diff = abs(seconds - track.duration)

        if diff < 2:
            score += 10

    return score


def resolve(track, candidates):

    best = None
    best_score = -1

    for candidate in candidates:

        s = score(track, candidate)

        if s > best_score:
            best_score = s
            best = candidate

    return best, round(best_score, 1)
